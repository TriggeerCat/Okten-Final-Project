# local docker database (docker compose up -d database)
MONGO_URI=mongodb://admin:verysecretpassword@localhost:27017/crm?authSource=admin
PORT=5000
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACTION_SECRET=change-me-action

# lifetimes are in milliseconds
# 10 minutes
JWT_ACCESS_LIFETIME=600000
# 30 days
JWT_REFRESH_LIFETIME=2592000000
# 30 minutes (activate / recovery password link)
JWT_ACTION_LIFETIME=1800000

# default super admin, created on startup if missing
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin
